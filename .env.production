# RustIM 环境配置 - 从 config.yaml 转换而来
# 基础配置
ENVIRONMENT=production
APP_NAME=RustIM
APP_VERSION=1.0.0
COMPONENT=all

# API 网关配置
GATEWAY_RATE_LIMIT_GLOBAL_REQUESTS_PER_SECOND=1000
GATEWAY_RATE_LIMIT_GLOBAL_BURST_SIZE=50
GATEWAY_RATE_LIMIT_GLOBAL_ENABLED=true

# 认证配置
GATEWAY_AUTH_JWT_ENABLED=true
GATEWAY_AUTH_JWT_SECRET=change_this_to_a_secure_random_string
GATEWAY_AUTH_JWT_ISSUER=api-gateway
GATEWAY_AUTH_JWT_EXPIRY_SECONDS=86400
GATEWAY_AUTH_JWT_REFRESH_EXPIRY_SECONDS=604800
GATEWAY_AUTH_JWT_VERIFY_ISSUER=false

# 重试与熔断配置
GATEWAY_RETRY_MAX_RETRIES=3
GATEWAY_RETRY_INTERVAL_MS=200
GATEWAY_CIRCUIT_BREAKER_ENABLED=true
GATEWAY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_BREAKER_HALF_OPEN_TIMEOUT_SECS=30

# 日志配置
LOG_LEVEL=info
LOG_OUTPUT=console
LOG_FORMAT=json
LOG_SQLX_LEVEL=debug
LOG_COMPONENT_TOWER=warn
LOG_COMPONENT_HYPER=warn
LOG_COMPONENT_AXUM=info
LOG_COMPONENT_TONIC=info
LOG_COMPONENT_RUSTIM=debug
LOG_COMPONENT_REDIS=warn

# 链路追踪配置
TELEMETRY_ENABLED=true
TELEMETRY_ENDPOINT=http://localhost:4317
TELEMETRY_SAMPLING_RATIO=1.0
TELEMETRY_PROPAGATION=tracecontext

# 数据库配置
DATABASE_URL=postgresql://postgres:@localhost:5432/rustim
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_DATABASE=rustim

# MongoDB 配置
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DATABASE=im
MONGODB_CLEAN_PERIOD=3600

# 服务配置
SERVER_HOST=127.0.0.1
SERVER_PORT=50001
SERVER_WS_LB_STRATEGY=RoundRobin

# Consul 服务注册与发现配置
SERVICE_CENTER_HOST=127.0.0.1
SERVICE_CENTER_PORT=8500
SERVICE_CENTER_TIMEOUT=8080
SERVICE_CENTER_PROTOCOL=http
SERVICE_CENTER_REFRESH_INTERVAL=30

# WebSocket 配置
WEBSOCKET_PROTOCOL=ws
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_PORT=8085
WEBSOCKET_NAME=websocket
WEBSOCKET_HEALTH_CHECK_TYPE=http
WEBSOCKET_HEALTH_CHECK_URL=/health
WEBSOCKET_HEALTH_CHECK_INTERVAL=15
WEBSOCKET_HEALTH_CHECK_TIMEOUT=60
WEBSOCKET_HEALTH_CHECK_DEREGISTER_AFTER=60

# RPC 服务配置
RPC_API_PROTOCOL=http
RPC_API_HOST=127.0.0.1
RPC_API_PORT=50000
RPC_API_NAME=api

RPC_WS_PROTOCOL=http
RPC_WS_HOST=127.0.0.1
RPC_WS_PORT=50001
RPC_WS_NAME=ws

RPC_CHAT_PROTOCOL=http
RPC_CHAT_HOST=127.0.0.1
RPC_CHAT_PORT=50002
RPC_CHAT_NAME=chat

RPC_PUSHER_PROTOCOL=http
RPC_PUSHER_HOST=127.0.0.1
RPC_PUSHER_PORT=50003
RPC_PUSHER_NAME=pusher

RPC_USER_PROTOCOL=http
RPC_USER_HOST=127.0.0.1
RPC_USER_PORT=50004
RPC_USER_NAME=user

RPC_FRIEND_PROTOCOL=http
RPC_FRIEND_HOST=127.0.0.1
RPC_FRIEND_PORT=50005
RPC_FRIEND_NAME=friend

RPC_GROUP_PROTOCOL=http
RPC_GROUP_HOST=127.0.0.1
RPC_GROUP_PORT=50006
RPC_GROUP_NAME=group

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_SEQ_STEP=10000
REDIS_MAX_CONNECTIONS=100
REDIS_POOL_TIMEOUT_MS=5000
REDIS_CONNECTION_TIMEOUT_MS=5000

# Kafka 配置
KAFKA_HOSTS=127.0.0.1:9092
KAFKA_TOPIC=rustIM-chat
KAFKA_GROUP=chat
KAFKA_CONNECT_TIMEOUT=5000
KAFKA_PRODUCER_TIMEOUT=3000
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_MAX_RETRY=3
KAFKA_PRODUCER_RETRY_INTERVAL=1000
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_SESSION_TIMEOUT=20000

# OSS 配置
OSS_ENDPOINT=http://127.0.0.1:9000
OSS_ACCESS_KEY=minioadmin
OSS_SECRET_KEY=minioadmin
OSS_BUCKET=rustIM
OSS_AVATAR_BUCKET=rustIM-avatar
OSS_REGION=us-east-1

# Rust 环境变量
RUST_LOG=info,sqlx=debug,tower=warn,hyper=warn,axum=info,tonic=info,rustIM=debug,redis=warn
RUST_BACKTRACE=1