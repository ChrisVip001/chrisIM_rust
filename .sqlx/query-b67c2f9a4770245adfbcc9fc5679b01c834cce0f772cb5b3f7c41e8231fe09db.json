{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT g.*, COUNT(r.friend_id) as \"friend_count!: i32\"\n            FROM friend_group g\n            LEFT JOIN friend_group_relation r ON g.id = r.group_id\n            WHERE g.user_id = $1\n            GROUP BY g.id\n            ORDER BY g.sort_order ASC\n            ",
