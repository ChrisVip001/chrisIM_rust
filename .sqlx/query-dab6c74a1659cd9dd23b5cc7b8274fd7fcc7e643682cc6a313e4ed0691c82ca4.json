{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT g.id, g.user_id, g.group_name, g.sort_order, g.created_at, g.updated_at\n            FROM friend_group g\n            WHERE g.user_id = $1\n            AND g.id IN (\n                SELECT group_id FROM friend_group_relation \n                WHERE user_id = $1 AND friend_id = $2\n            )\n            ORDER BY g.sort_order ASC, g.created_at ASC\n            ",
