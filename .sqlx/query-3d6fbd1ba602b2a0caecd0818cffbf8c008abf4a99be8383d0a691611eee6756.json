  "db_name": "PostgreSQL",
  "query": "\n            SELECT m.id, m.group_id, m.user_id, m.role, m.joined_at, \n                   u.username, u.nickname, u.avatar_url, m.is_muted\n            FROM group_members m\n            JOIN users u ON m.user_id = u.id\n            WHERE m.group_id = $1 AND m.user_id = $2\n            ",
