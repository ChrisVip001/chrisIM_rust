  "query": "\n            SELECT \n                ub.id, \n                ub.user_id, \n                ub.blocked_user_id, \n                ub.reason, \n                ub.created_at\n            FROM user_blacklist ub\n            WHERE ub.user_id = $1\n            ORDER BY ub.created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
