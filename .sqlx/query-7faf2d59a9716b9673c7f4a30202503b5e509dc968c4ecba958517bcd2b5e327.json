{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                ub.id, \n                ub.user_id, \n                ub.blocked_user_id, \n                ub.reason, \n                ub.created_at,\n                u.username,\n                u.nickname,\n                u.avatar_url\n            FROM user_blacklist ub\n            LEFT JOIN users u ON ub.blocked_user_id = u.id\n            WHERE ub.user_id = $1\n            ORDER BY ub.created_at DESC\n            ",
