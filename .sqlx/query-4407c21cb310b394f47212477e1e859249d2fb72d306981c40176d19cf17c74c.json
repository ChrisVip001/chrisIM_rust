  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                id, user_id, friend_id, message, status, created_at, updated_at, reject_reason\n            FROM friendships\n            WHERE (user_id = $1 AND friend_id = $2) OR (user_id = $2 AND friend_id = $1)\n            ORDER BY created_at DESC\n            LIMIT 1\n            ",
